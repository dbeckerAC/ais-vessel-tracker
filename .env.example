AISSTREAM_API_KEY=replace-with-your-aisstream-key
DATABASE_URL=postgresql://ais:ais@db:5432/ais
HISTORY_SAMPLE_SECONDS=60
TRACK_GAP_MINUTES=45
TRIP_GAP_HOURS=6
AISSTREAM_MAX_MMSIS=50
OPENWATERS_ENABLED=true
OPENWATERS_MAX_MMSIS=10
# Anonymous access covers up to 10 MMSIs. With a personal token, set the limit to 50:
# OPENWATERS_MAX_MMSIS=50
# OPENWATERS_API_KEY=ak1.replace-with-your-token

# Mac-to-Raspberry-Pi deployment/status scripts (local only; never commit .env)
PI_HOST=your-user@your-pi-host-or-ip
PI_DIR=/home/your-user/ais-tools
